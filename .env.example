# Variables for the backend service (Railway -> Variables). Do NOT put real values in this file.
# Comments sit on their own lines on purpose: a trailing comment may be read as part of the value.
# Spec: vault/04-Architecture/Desain Backend.md

# --- Required ---
# Monad testnet RPC (chain 10143). Several comma-separated URLs allowed: fallback when one fails / is rate-limited.
# Public RPC allows 15 requests/s per IP; a keyed RPC is still better (SPK-05).
# Tested: https://testnet-rpc.monad.xyz,https://10143.rpc.thirdweb.com (drpc.org rejects some methods from Railway IPs)
RPC_URL=
# Max requests/s per non-local URL (extra requests wait instead of failing)
RPC_RPS=12
# Dedicated wallets for the faucet, keeper and (optional) bot. One wallet per role.
FAUCET_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
# FE Vercel domain, e.g. https://app-name.vercel.app (comma-separated if more than one)
ALLOWED_ORIGIN=
# Long random token for POST /admin/bot
ADMIN_TOKEN=
# Wallet granted the tIDRX MINTER_ROLE at deploy (env MINTER in Deploy.s.sol); mints the balance after a top-up
MINTER_PRIVATE_KEY=
# Relayer wallet: pays MON gas for createOrderFor, receives the tIDRX fee
RELAYER_PRIVATE_KEY=
# Public URL of the service (for the simulated checkout paymentUrl), e.g. https://be-name.up.railway.app
PUBLIC_URL=

# --- Optional ---
# Empty = order bot disabled
BOT_PRIVATE_KEY=
# MON per new address
FAUCET_AMOUNT=0.05
# Mainnet: access code required in the /faucet body { address, kode } (empty = no code) and a cap on total MON paid out
FAUCET_KODE=
FAUCET_MAX_TOTAL=
# Below this balance /faucet answers 503 FAUCET_EMPTY. At least 10 MON + a bit: Monad's reserve balance makes
# transfers that drop the sender below 10 MON revert (docs.monad.xyz, Reserve Balance)
FAUCET_MIN_BALANCE=10.5
# Per IP per minute; generous because the audience on venue WiFi shares an IP
RATE_LIMIT_PER_MIN=120
KEEPER=on
BOT=off
KEEPER_INTERVAL_MS=2000
BOT_INTERVAL_MS=8000
# Set these if not using shared/src/fotokopiKilat.generated.ts from the testnet export
CONTRACT_ADDRESS=
BATAS_ANTRE=45
TOKEN_ADDRESS=
# simulasi = fake checkout + tIDRX mint; live = api.idrx.co (not tested yet, SPK-19);
# voucher = mainnet demo: free TOPUP_VOUCHER_RP balance once per address from the treasury wallet (MINTER_PRIVATE_KEY), requires TOPUP_KODE
IDRX_MODE=simulasi
TOPUP_VOUCHER_RP=5000
# Empty = use FAUCET_KODE
TOPUP_KODE=
# Rupiah per top-up and total per address (while the service is up)
TOPUP_MAX=1000000
TOPUP_MAX_PER_ADDRESS=2000000
TOPUP_EXPIRY_MIN=15
# Only for IDRX_MODE=live. Set directly in Railway, never share over chat.
IDRX_API_KEY=
IDRX_API_SECRET=
# PORT is set automatically by Railway

# --- Documents + radius (BLZ-21, BLZ-22) ---
# Data folder (Railway volume at /data). Railway: set RAILWAY_RUN_UID=0 so the container user can write to the volume
DATA_DIR=./data
# Document encryption master key, 32-byte hex (openssl rand -hex 32). Set directly in Railway; without it documents are lost on restart
DOKUMEN_KEY=
DOKUMEN_MAX_MB=10
# Uploads never used by an order are deleted after this many minutes
DOKUMEN_TTL_MENIT=120
RADIUS_KM=1.5
# Feed radius for Toko Pro (onchain subscription, isPro)
RADIUS_PRO_KM=3
INDEKS_INTERVAL_MS=2000

