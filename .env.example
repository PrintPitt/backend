# Variabel untuk service backend (Railway -> Variables). JANGAN isi file ini dengan nilai asli.
# Komentar sengaja di baris sendiri: komentar di ujung baris bisa ikut terbaca sebagai nilai.
# Spesifikasi: vault/04-Architecture/Desain Backend.md

# --- Wajib ---
# RPC Monad testnet (chain 10143). Boleh beberapa URL dipisah koma: fallback bila satu gagal / kena limit.
# RPC publik membatasi 15 request/dtk per IP; RPC berkunci tetap lebih baik (SPK-05).
# Teruji: https://testnet-rpc.monad.xyz,https://10143.rpc.thirdweb.com (drpc.org menolak sebagian method dari IP Railway)
RPC_URL=
# Batas request/dtk per URL non-lokal (request mengantre, tidak gagal)
RPC_RPS=12
# Wallet khusus faucet, keeper, dan (opsional) bot. Satu wallet per peran.
FAUCET_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
# Domain Vercel FE, mis. https://nama-app.vercel.app (pisahkan dengan koma bila lebih dari satu)
ALLOWED_ORIGIN=
# Token acak panjang untuk POST /admin/bot
ADMIN_TOKEN=
# Wallet yang diberi MINTER_ROLE tIDRX saat deploy (env MINTER di Deploy.s.sol); mencetak saldo setelah top-up
MINTER_PRIVATE_KEY=
# Wallet relayer: bayar gas MON untuk createOrderFor, menerima fee tIDRX
RELAYER_PRIVATE_KEY=
# URL publik service (untuk paymentUrl checkout simulasi), mis. https://nama-be.up.railway.app
PUBLIC_URL=

# --- Opsional ---
# Kosong = order bot nonaktif
BOT_PRIVATE_KEY=
# MON per alamat baru
FAUCET_AMOUNT=0.05
# Di bawah saldo ini /faucet menjawab 503 FAUCET_EMPTY. Minimal 10 MON + sedikit: Monad reserve balance membuat
# transfer yang menurunkan saldo pengirim di bawah 10 MON revert (docs.monad.xyz, Reserve Balance)
FAUCET_MIN_BALANCE=10.5
# Per IP per menit; longgar karena penonton di WiFi venue berbagi IP
RATE_LIMIT_PER_MIN=120
KEEPER=on
BOT=off
KEEPER_INTERVAL_MS=2000
BOT_INTERVAL_MS=8000
# Isi bila tidak memakai shared/src/fotokopiKilat.generated.ts hasil export testnet
CONTRACT_ADDRESS=
BATAS_ANTRE=45
TOKEN_ADDRESS=
# simulasi = checkout palsu + mint tIDRX; live = api.idrx.co (belum diuji, SPK-19)
IDRX_MODE=simulasi
# Rupiah per top-up dan total per alamat (selama service hidup)
TOPUP_MAX=1000000
TOPUP_MAX_PER_ADDRESS=2000000
TOPUP_EXPIRY_MIN=15
# Hanya untuk IDRX_MODE=live. Isi langsung di Railway, jangan kirim lewat chat.
IDRX_API_KEY=
IDRX_API_SECRET=
# PORT diisi otomatis oleh Railway

# --- Dokumen + radius (BLZ-21, BLZ-22) ---
# Folder data (volume Railway di /data). Railway: set RAILWAY_RUN_UID=0 supaya user container bisa menulis ke volume
DATA_DIR=./data
# Master key enkripsi dokumen, 32 byte hex (openssl rand -hex 32). Isi langsung di Railway; tanpa ini dokumen hilang saat restart
DOKUMEN_KEY=
DOKUMEN_MAX_MB=10
# Upload yang tidak pernah dipakai order dihapus setelah sekian menit
DOKUMEN_TTL_MENIT=120
RADIUS_KM=1.5
# Radius feed untuk Toko Pro (langganan on-chain, isPro)
RADIUS_PRO_KM=3
INDEKS_INTERVAL_MS=2000

