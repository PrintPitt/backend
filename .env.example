# Variabel untuk service backend (Railway -> Variables). JANGAN isi file ini dengan nilai asli.
# Komentar sengaja di baris sendiri: komentar di ujung baris bisa ikut terbaca sebagai nilai.
# Spesifikasi: vault/04-Architecture/Desain Backend.md

# --- Wajib ---
# RPC berkunci Monad testnet (chain 10143); RPC publik kena 429 saat ramai (SPK-05)
RPC_URL=
# Wallet khusus faucet, keeper, dan (opsional) bot. Satu wallet per peran.
FAUCET_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
# Domain Vercel FE, mis. https://nama-app.vercel.app (pisahkan dengan koma bila lebih dari satu)
ALLOWED_ORIGIN=
# Token acak panjang untuk POST /admin/bot
ADMIN_TOKEN=
# Wallet yang diberi MINTER_ROLE tIDRX saat deploy (env MINTER di Deploy.s.sol); mencetak saldo setelah top-up
MINTER_PRIVATE_KEY=
# Wallet relayer: bayar gas MON untuk createOrderFor, menerima fee tIDRX
RELAYER_PRIVATE_KEY=
# URL publik service (untuk paymentUrl checkout simulasi), mis. https://nama-be.up.railway.app
PUBLIC_URL=

# --- Opsional ---
# Kosong = order bot nonaktif
BOT_PRIVATE_KEY=
# MON per alamat baru
FAUCET_AMOUNT=0.05
# Di bawah saldo ini /faucet menjawab 503 FAUCET_EMPTY
FAUCET_MIN_BALANCE=0.5
# Per IP per menit; longgar karena penonton di WiFi venue berbagi IP
RATE_LIMIT_PER_MIN=120
KEEPER=on
BOT=off
KEEPER_INTERVAL_MS=2000
BOT_INTERVAL_MS=8000
# Isi bila tidak memakai shared/src/fotokopiKilat.generated.ts hasil export testnet
CONTRACT_ADDRESS=
BATAS_ANTRE=45
TOKEN_ADDRESS=
# simulasi = checkout palsu + mint tIDRX; live = api.idrx.co (belum diuji, SPK-19)
IDRX_MODE=simulasi
# Rupiah per top-up dan total per alamat (selama service hidup)
TOPUP_MAX=1000000
TOPUP_MAX_PER_ADDRESS=2000000
TOPUP_EXPIRY_MIN=15
# Hanya untuk IDRX_MODE=live. Isi langsung di Railway, jangan kirim lewat chat.
IDRX_API_KEY=
IDRX_API_SECRET=
# PORT diisi otomatis oleh Railway
